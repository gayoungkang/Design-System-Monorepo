{
  "name": "@acme/ui",
  "version": "1.0.0",
  "private": true,
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "styled-components": ">=6"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": false
    }
  },
  "dependencies": {
    "dayjs": "^1.11.19",
    "lodash": "^4.17.21",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.56.2",
    "@storybook/addon-a11y": "8.6.15",
    "@storybook/addon-essentials": "8.6.15",
    "@storybook/addon-themes": "8.6.15",
    "@storybook/react-vite": "8.6.15",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^28.0.0",
    "storybook": "8.6.15",
    "tsc-alias": "^1.8.16",
    "tsup": "^8.0.0",
    "typescript": "^5.6.3",
    "vite": "^7.2.7",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "build": "tsup",
    "build:types": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:test": "storybook test --watch=false",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "build:dts": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "api:check": "yarn build:dts && node -e \"require('fs').mkdirSync('etc',{recursive:true})\" && api-extractor run --config ./api-extractor.json --local"
  }
}
